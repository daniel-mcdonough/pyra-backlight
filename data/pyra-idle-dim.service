[Unit]
Description=Dim the screen and turn the keyboard light off when the session goes idle
Documentation=file:/usr/bin/pyra-idle-dim
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/pyra-idle-dim
# Rereads ~/.config/pyra-backlight.conf.
ExecReload=kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# Percent of maximum brightness to drop to when idle.
Environment=PYRA_DIM_PERCENT=20

[Install]
WantedBy=default.target
