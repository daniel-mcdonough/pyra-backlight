#!/usr/bin/python3
#
# pyra-idle-dim — dim the screen backlight when the session goes idle, and put
# it back when it wakes. Also turns the keyboard light off when idle, and puts
# the keyboard light's level back at login. Runs as the logged-in user, needs
# no root.
#
# WHY THIS EXISTS
#
# MATE already has this feature and it does not work on the Pyra. Its helper,
# mate-power-backlight-helper, looks through /sys/class/backlight for a device
# it recognises, finds none of the names it knows, and takes whatever the
# directory hands it first. On this machine that is keyboard-backlight rather
# than backlight, so "dim the screen" dims the keyboard and the panel never
# changes. That is almost certainly why the Pyra image ships
# backlight-enable=false in 99_pyra.gschema.override: the feature was pointed
# at the wrong lamp, so it was switched off.
#
# This names the device explicitly instead of guessing, and changes it through
# logind, which lets the session owner set its own backlight without root.
#
# The idle signal comes from the session manager, so the delay is whatever
# org.mate.session idle-delay is set to. Set that, not anything here.
#
# How far the screen dims is set in ~/.config/pyra-backlight.conf:
#
#   [screen]
#   dim = 20            # percent of maximum, 1-100, or off
#
# It never dims below the lowest step that still lights the panel (1).
# Without the key, PYRA_DIM_PERCENT from the environment is used, then 20.
#
# THE KEYBOARD LIGHT
#
# At login on AC, mate-power-manager sets the keyboard light to 100%, whatever
# it was. So this waits for mate-power-manager to appear on the session bus
# and then sets the level from ~/.config/pyra-backlight.conf:
#
#   [keyboard]
#   level = last        # or a percentage, 0-100
#
# "last" is the level the light had at the last idle or logout, kept in
# $XDG_STATE_HOME/pyra-backlight/kbd-level. With nothing kept yet it is 5%.
# Only a keyboard light that is an LED (*::kbd_backlight) is handled; without
# one this does the screen only. The file is reread on SIGHUP
# (systemctl --user reload pyra-idle-dim); a new fixed level is set at once.
# The session restarts this at each
# login (/etc/xdg/autostart/pyra-idle-dim.desktop).
#
# THE UNLOCK DIALOG
#
# The session stays idle while mate-screensaver's password dialog is up, so
# without help the password is typed in the dark. mate-screensaver says
# nothing on D-Bus when the dialog opens, but the dialog is its own child
# process, mate-screensaver-dialog. So while the screensaver is active this
# looks for that child every half second, puts light and screen back while
# it is there, and turns them down again if it goes without an unlock.
#
# Copyright (C) 2026 the pyra-backlight authors
# SPDX-License-Identifier: GPL-2.0-or-later
#
import configparser
import os
import signal
import sys
import time

import gi
gi.require_version("GLib", "2.0")
from gi.repository import Gio, GLib

DEVICE = os.environ.get("PYRA_DIM_DEVICE", "backlight")
# Percent of maximum to drop to when idle, when neither the config file nor
# PYRA_DIM_PERCENT sets it.
DIM_DEFAULT = 20

SYS = "/sys/class/backlight/" + DEVICE
STATUS_IDLE = 3

LEDS = "/sys/class/leds"
CONFIG = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "pyra-backlight.conf")
KBD_STATE = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "pyra-backlight", "kbd-level")
# The keyboard level for "last" when no level has been kept yet.
KBD_FIRST_LEVEL = 5
# mate-power-manager's bus name. It does its keyboard reset at start, so the
# level is put back once this name is on the bus.
POWER_MANAGER = "org.mate.PowerManager"
# How long to wait for it before putting the level back anyway.
POWER_MANAGER_TIMEOUT = 30
# mate-screensaver's bus name and its unlock dialog, a child process.
SCREENSAVER = "org.mate.ScreenSaver"
DIALOG = b"mate-screensaver-dialog"
DIALOG_POLL_MS = 500
# How long the dialog must be gone before light and screen go down again.
# At an unlock the dialog exits just before ActiveChanged false is sent.
DIALOG_GONE_MS = 2000

saved = None
# The session's last Presence status.
status_now = None
# Percent of maximum to drop to when idle, or None for no screen dimming.
dim_percent = DIM_DEFAULT
# What we dimmed to, so that waking can tell whether anyone changed the
# brightness in the meantime, from the panel applet or anywhere else.
dimmed_to = None


def log(msg):
    print(msg, flush=True)


def read(name):
    with open(os.path.join(SYS, name)) as f:
        return int(f.read().strip())


def set_brightness(system_bus, value, subsystem="backlight", device=DEVICE):
    # logind lets the session owner set the brightness of its own seat's
    # devices. Writing the sysfs file directly would need root.
    system_bus.call_sync(
        "org.freedesktop.login1",
        "/org/freedesktop/login1/session/auto",
        "org.freedesktop.login1.Session",
        "SetBrightness",
        GLib.Variant("(ssu)", (subsystem, device, value)),
        None, Gio.DBusCallFlags.NONE, 5000, None,
    )


def find_keyboard():
    # The same lookup as the applet's, minus its fallback: the stock kernel's
    # keyboard-backlight device is left alone.
    try:
        leds = sorted(n for n in os.listdir(LEDS)
                      if n.endswith("::kbd_backlight"))
    except OSError:
        return None
    return leds[0] if leds else None


def parse_dim(value):
    """A screen dim depth: 1-100, or None for "off". ValueError otherwise."""
    value = value.strip().lower()
    if value == "off":
        return None
    try:
        percent = int(value)
    except ValueError:
        percent = 0
    if not 1 <= percent <= 100:
        raise ValueError(value)
    return percent


def describe_dim(percent):
    return "off" if percent is None else f"{percent}%"


def env_dim():
    """The dim depth from PYRA_DIM_PERCENT, or the default."""
    value = os.environ.get("PYRA_DIM_PERCENT")
    if value is None:
        return DIM_DEFAULT
    try:
        return parse_dim(value)
    except ValueError:
        log(f"PYRA_DIM_PERCENT={value} is not 1-100 or off; "
            f"using {DIM_DEFAULT}%")
        return DIM_DEFAULT


def read_config():
    """The [keyboard] level ("last" or 0-100) and the [screen] dim depth
    (1-100, or None for off) from the config file."""
    parser = configparser.ConfigParser(interpolation=None)
    try:
        parser.read(CONFIG)
    except configparser.Error as e:
        log(f"{CONFIG}: {e}; using the defaults")
        return "last", env_dim()
    return keyboard_level(parser), screen_dim(parser)


def keyboard_level(parser):
    value = parser.get("keyboard", "level", fallback="last").strip().lower()
    if value == "last":
        return value
    try:
        level = int(value)
    except ValueError:
        level = -1
    if not 0 <= level <= 100:
        log(f"{CONFIG}: [keyboard] level = {value} is not 'last' or 0-100; "
            "using 'last'")
        return "last"
    return level


def screen_dim(parser):
    value = parser.get("screen", "dim", fallback=None)
    if value is None:
        return env_dim()
    try:
        return parse_dim(value)
    except ValueError:
        percent = env_dim()
        log(f"{CONFIG}: [screen] dim = {value.strip()} is not 1-100 or off; "
            f"using {describe_dim(percent)}")
        return percent


class Keyboard:
    def __init__(self, system_bus, name, level):
        self.system_bus = system_bus
        self.name = name
        self.path = os.path.join(LEDS, name, "brightness")
        self.level = level
        # The level before the light went off for idle, or None when it is
        # not off for idle.
        self.saved = None
        # Until the level at login is set, the light may be at MATE's 100%,
        # which is not a level to keep.
        self.logged_in = False

    def read(self):
        with open(self.path) as f:
            return int(f.read().strip())

    def set(self, value):
        try:
            set_brightness(self.system_bus, value, "leds", self.name)
        except GLib.Error as e:
            log(f"keyboard: SetBrightness({value}) failed: {e.message}")

    def kept(self):
        try:
            with open(KBD_STATE) as f:
                level = int(f.read().strip())
        except (OSError, ValueError):
            return None
        return level if 0 <= level <= 100 else None

    def keep(self, level):
        try:
            os.makedirs(os.path.dirname(KBD_STATE), exist_ok=True)
            tmp = KBD_STATE + ".tmp"
            with open(tmp, "w") as f:
                f.write(f"{level}\n")
            os.replace(tmp, KBD_STATE)
        except OSError as e:
            log(f"keyboard: cannot keep the level in {KBD_STATE}: {e}")

    def login(self, how):
        if self.level == "last":
            target = self.kept()
            if target is None:
                target = KBD_FIRST_LEVEL
        else:
            target = self.level
        log(f"login ({how}): keyboard {self.read()} -> {target}")
        self.set(target)
        self.logged_in = True
        # Says whether something reset the light after us, which would mean
        # the trigger above is too early.
        GLib.timeout_add_seconds(10, self.check, target)

    def check(self, target):
        now = self.read()
        if now != target:
            log(f"login: keyboard is {now} 10 s after setting {target}")
        return GLib.SOURCE_REMOVE

    def idle(self):
        if self.saved is not None:
            return
        now = self.read()
        if now == 0:
            return
        log(f"idle: keyboard {now} -> 0")
        self.keep(now)
        self.saved = now
        self.set(0)

    def awake(self):
        if self.saved is None:
            return
        now = self.read()
        if now != 0:
            log(f"awake: keyboard is {now}, not 0; leaving it")
        else:
            log(f"awake: keyboard restoring {self.saved}")
            self.set(self.saved)
        self.saved = None

    def reload(self, level):
        """Takes a new level from the config file. A new fixed level is set
        now, so a save in the settings app shows at once; "last" is the
        light's current level already, and an unchanged level leaves alone a
        light changed with the Fn keys since."""
        changed = level != self.level
        self.level = level
        if not changed or level == "last" or not self.logged_in:
            # Before the login level is set, login() will set it.
            return
        if self.saved is not None:
            log(f"reload: keyboard off for idle; {level} at wake")
            self.saved = level
            return
        log(f"reload: keyboard {self.read()} -> {level}")
        self.set(level)

    def stop(self):
        if self.logged_in:
            self.keep(self.saved if self.saved is not None else self.read())


def on_status(bus, sender, path, iface, sig, params, data):
    global status_now
    system_bus, keyboard = data
    status_now = params[0]
    apply_status(system_bus, keyboard, status_now)


def apply_status(system_bus, keyboard, status):
    if keyboard:
        if status == STATUS_IDLE:
            keyboard.idle()
        else:
            keyboard.awake()
    dim_screen(system_bus, status)


def dim_screen(system_bus, status):
    global saved, dimmed_to
    if status == STATUS_IDLE:
        if saved is not None or dim_percent is None:
            return
        saved = read("actual_brightness")
        # 0 turns the panel's light off; blanking is the screensaver's job.
        target = max(1, read("max_brightness") * dim_percent // 100)
        if target >= saved:
            # Already dimmer than we would make it. Leave it alone.
            saved = None
            return
        log(f"idle: {saved} -> {target}")
        set_brightness(system_bus, target)
        dimmed_to = target
    else:
        if saved is None:
            return
        now = read("brightness")
        if now != dimmed_to:
            # Someone set the brightness while we had it dimmed. Theirs is
            # the newer choice, so putting ours back would undo it.
            log(f"awake: brightness is {now}, not {dimmed_to}; leaving it")
        else:
            log(f"awake: restoring {saved}")
            set_brightness(system_bus, saved)
        saved = None
        dimmed_to = None


class Lock:
    """Light and screen up while mate-screensaver's unlock dialog is."""

    def __init__(self, session_bus, system_bus, keyboard):
        self.session_bus = session_bus
        self.system_bus = system_bus
        self.keyboard = keyboard
        self.pid = None
        self.timer = None
        # Whether light and screen are up for the dialog.
        self.up = False
        # How long the dialog has been gone since it was up, in ms.
        self.gone = 0

    def on_active(self, bus, sender, path, iface, sig, params, data):
        if params[0]:
            if self.timer is None:
                self.pid = self.owner_pid(sender)
                if self.pid:
                    self.timer = GLib.timeout_add(DIALOG_POLL_MS, self.poll)
        elif self.timer is not None:
            GLib.source_remove(self.timer)
            self.timer = None
            self.up = False
            self.gone = 0

    def owner_pid(self, sender):
        try:
            return self.session_bus.call_sync(
                "org.freedesktop.DBus", "/org/freedesktop/DBus",
                "org.freedesktop.DBus", "GetConnectionUnixProcessID",
                GLib.Variant("(s)", (sender,)), GLib.VariantType("(u)"),
                Gio.DBusCallFlags.NONE, 5000, None)[0]
        except GLib.Error as e:
            log(f"lock: no pid for {SCREENSAVER}: {e.message}")
            return None

    def dialog(self):
        """Whether mate-screensaver has its unlock dialog running."""
        children = []
        task = f"/proc/{self.pid}/task"
        try:
            for tid in os.listdir(task):
                with open(os.path.join(task, tid, "children")) as f:
                    children += f.read().split()
        except OSError:
            return False
        for child in children:
            try:
                with open(f"/proc/{child}/cmdline", "rb") as f:
                    argv0 = f.read().split(b"\0")[0]
            except OSError:
                continue
            if os.path.basename(argv0) == DIALOG:
                return True
        return False

    def poll(self):
        if self.dialog():
            self.gone = 0
            if not self.up:
                self.up = True
                log("lock: unlock dialog up")
                apply_status(self.system_bus, self.keyboard, 0)
        elif self.up:
            self.gone += DIALOG_POLL_MS
            if self.gone >= DIALOG_GONE_MS:
                self.up = False
                self.gone = 0
                log("lock: unlock dialog gone, still locked")
                if status_now == STATUS_IDLE:
                    apply_status(self.system_bus, self.keyboard, STATUS_IDLE)
        return GLib.SOURCE_CONTINUE


def watch_login(session_bus, keyboard):
    start = time.monotonic()
    done = False
    watch = None

    def apply(how):
        nonlocal done
        if done:
            return
        done = True
        Gio.bus_unwatch_name(watch)
        keyboard.login(f"{how} after {time.monotonic() - start:.1f} s")

    def appeared(conn, name, owner):
        apply(f"{POWER_MANAGER} appeared")

    def timeout():
        if not done:
            log(f"no {POWER_MANAGER} on the session bus")
            apply("timeout")
        return GLib.SOURCE_REMOVE

    watch = Gio.bus_watch_name_on_connection(
        session_bus, POWER_MANAGER, Gio.BusNameWatcherFlags.NONE,
        appeared, None)
    GLib.timeout_add_seconds(POWER_MANAGER_TIMEOUT, timeout)


def main():
    global dim_percent
    if not os.path.isdir(SYS):
        sys.exit(f"no backlight device at {SYS}")

    system_bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    session_bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    # Prove we can actually drive it before claiming to be running, so a broken
    # setup fails at start rather than silently doing nothing hours later.
    set_brightness(system_bus, read("actual_brightness"))

    level, dim_percent = read_config()
    name = find_keyboard()
    keyboard = Keyboard(system_bus, name, level) if name else None

    loop = GLib.MainLoop()

    def stop():
        if keyboard:
            keyboard.stop()
        loop.quit()
        return GLib.SOURCE_REMOVE

    def reload():
        global dim_percent
        level, dim_percent = read_config()
        if keyboard:
            keyboard.reload(level)
        log(f"reloaded {CONFIG}: keyboard level {level}, "
            f"screen dim {describe_dim(dim_percent)}")
        return GLib.SOURCE_CONTINUE

    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, stop)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, stop)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGHUP, reload)

    session_bus.signal_subscribe(
        None, "org.gnome.SessionManager.Presence", "StatusChanged",
        "/org/gnome/SessionManager/Presence", None,
        Gio.DBusSignalFlags.NONE, on_status, (system_bus, keyboard),
    )
    lock = Lock(session_bus, system_bus, keyboard)
    session_bus.signal_subscribe(
        None, SCREENSAVER, "ActiveChanged", "/org/mate/ScreenSaver", None,
        Gio.DBusSignalFlags.NONE, lock.on_active, None,
    )
    if keyboard:
        watch_login(session_bus, keyboard)
        log(f"keyboard {name}: level at login {keyboard.level}, off when idle")
    else:
        log("no keyboard LED; screen only")
    if dim_percent is None:
        log(f"watching for idle; {DEVICE} dimming off")
    else:
        log(f"watching for idle; {DEVICE} dims to {dim_percent}% of maximum")
    loop.run()


if __name__ == "__main__":
    main()
