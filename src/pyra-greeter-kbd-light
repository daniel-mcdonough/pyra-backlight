#!/bin/sh
#
# pyra-greeter-kbd-light: lightdm's greeter-setup-script. It runs as root
# before each login screen, at boot and after every logout, and sets the
# keyboard light to a fixed level so the password is not typed in the dark.
# No user is known at the login screen, so the level is not a user setting;
# pyra-idle-dim sets the user's own level at login.
#
# lightdm does not start the greeter if this fails, so it always exits 0.

# The level, in percent of max_brightness, is MATE's kbd-brightness-on-ac
# from pyra-backlight's schema override, so that MATE's own set at login
# changes nothing (see the override). 20 if it can't be read.
OVERRIDE=/usr/share/glib-2.0/schemas/60_pyra-backlight.gschema.override
LEVEL=$(sed -n 's/^kbd-brightness-on-ac=\([0-9]\{1,3\}\)[[:space:]]*$/\1/p' \
	"$OVERRIDE" 2>/dev/null | tail -n 1)
case $LEVEL in
''|*[!0-9]*) LEVEL=20 ;;
esac
[ "$LEVEL" -le 100 ] || LEVEL=20

for led in /sys/class/leds/*::kbd_backlight; do
	[ -w "$led/brightness" ] || continue
	max=$(cat "$led/max_brightness" 2>/dev/null) || continue
	echo $((max * LEVEL / 100)) > "$led/brightness" 2>/dev/null
done
exit 0
