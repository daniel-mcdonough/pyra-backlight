#!/bin/sh
set -e

#DEBHELPER#

# dh_installsystemduser does not reload running user managers. A user manager
# outlives a logout while any other session of that user is open, so it would
# keep the old pyra-idle-dim.service (and refuse its ExecReload) until reboot.
if [ "$1" = "configure" ] && [ -z "$DPKG_ROOT" ] && [ -d /run/systemd/system ]; then
	for dir in /run/user/*; do
		[ -d "$dir" ] || continue
		user=$(getent passwd "${dir##*/}" | cut -d: -f1) || continue
		[ -n "$user" ] || continue
		systemctl --user -M "$user@" daemon-reload >/dev/null 2>&1 || true
	done
fi

exit 0
